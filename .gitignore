# --- ROM ------------------------------------------------------------------
# Software comercial: cada pessoa traz a própria cópia legal. A regra 1 do
# AGENTS.md vale sem exceção — ninguém compartilha ROM.
#
# Elas ficaram versionadas entre 08/08 e 17/08/2026, enquanto o repositório era
# privado. Em 17/08/2026 o repositório virou público e o histórico inteiro foi
# reescrito com `git filter-repo` para apagar `roms/*.gb` e `roms/*.gb.ram` dos
# 122 commits. Não sobra nenhum blob de ROM: `git log --all -- 'roms/*'` volta
# vazio. Backup do histórico antigo em `../pokepilot-backup-pre-purge-*.bundle`,
# fora do repositório.
#
# Consequência: qualquer clone anterior a 17/08/2026 tem histórico incompatível
# e precisa ser refeito. Não reintroduza ROM no versionamento.
roms/*.gb
roms/*.gbc

# --- dependências ---------------------------------------------------------
.env
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# --- estado de execução, não código ---------------------------------------
# Cada jornada gera saves, snapshots do emulador e logs continuamente. É tudo
# derivado e específico de uma execução: nada aqui é necessário para o projeto
# rodar do zero. Os states de partida ficam em states/ e SÃO versionados.
trainers/
archives/
*.bak-*/
blue-agents/tasks/*.db
blue-agents/tasks/*.state
blue-agents/tasks/agent_states.json
blue-agents/tasks/runtime_controls.json
blue-agents/tasks/runtime_controls.json.tmp
blue-agents/tasks/training.pid
blue-agents/tasks/viz.pid
blue-agents/tasks/journey_memory/
blue-agents/tasks/decision_logs/
blue-agents/tasks/matplotlib/
blue-agents/tasks/save_state_signal
blue-agents/*_autosave.state
blue-agents/checkpoints/
blue-agents/tasks/journey_states/

# Ordem de quest solta pelo operador durante uma corrida (uma linha,
# `QUEST: <NOME>`). É comando de execução, não configuração do projeto.
blue-agents/tasks/*.txt

# Log e PID das corridas: 63 MB em 17/08/2026, um arquivo por jornada. O
# `*.log` mais abaixo já pegaria os logs, mas não o PID — e a pasta inteira é
# execução, nada aqui reconstrói o projeto.
runtime/

# Pasta criada por engano ao rodar um comando de dentro de blue-agents/ (o
# caminho vira blue-agents/blue-agents/). Não é estrutura do projeto.
blue-agents/blue-agents/

# Telemetria da execução: o feed é reescrito inteiro a cada jornada (milhares
# de linhas por corrida) e ninguém precisa dele para rodar do zero.
blue-agents/tasks/events_feed.json

# Save da bateria do cartucho, escrito pelo emulador ao sair. Derivado: os
# states em states/ já carregam a SRAM junto.
roms/*.gb.ram

# --- checkpoints de treino e telemetria -----------------------------------
# Pesados e regeneráveis a cada execução.
blue-agents/v2_repro_runs/
blue-agents/dashboard-react/dist/
dist/
runs/
wandb/

# --- logs -----------------------------------------------------------------
*.log

# --- sistema --------------------------------------------------------------
.DS_Store

# Terreno lido da tela: derivado, cresce sozinho e pode ser reconstruído.
blue-agents/knowledge/maps/terrain.json

# Cópias do mapa acumulado feitas antes de esquecer paredes inventadas
# (blue-agents/tools/forget_walls.py). São rede de segurança local, não dado
# do projeto — o terrain.json em si já é ignorado logo acima.
blue-agents/knowledge/maps/.envenenado/

# `static_maps.json` **não** entra aqui de propósito: é derivado da ROM, como
# warps.json e pokemon_centers.json, e como eles é autoridade em tempo de
# execução. Sem ele a navegação cai de volta na leitura de tela, que é o que
# se está substituindo. Regenerar: tools/extract_map_data.py --write

# Grafo de conhecimento do graphify: 5 MB derivados do próprio repo.
graphify-out/

# Trava de corrida: estado de execução, recriada a cada corrida.
blue-agents/tasks/journey.lock

# Saves que o watchdog de vida grava sozinho quando o cartucho para de mudar
# de estado (163 KB cada). São matéria bruta de diagnóstico: o que vira trecho
# de replay é promovido à mão para states/replay/ com entrada no manifesto.
states/replay/auto/
